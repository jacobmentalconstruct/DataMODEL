{
  "contract_version": 1,
  "id": "outline",
  "description": "Symbol map (defs/classes/headings/keys + line numbers) of a file or tree.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "file/dir"
      },
      "glob": {
        "type": "string",
        "minLength": 1,
        "description": "file filter"
      },
      "depth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "symbols": {
        "type": "boolean",
        "description": "false = files + line counts"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "max files (300)"
      },
      "all": {
        "type": "boolean",
        "description": "include ignored/vendor"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "files": {
        "type": "integer"
      },
      "symbols": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      },
      "error_kind": {
        "type": "string"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": false
  },
  "reads": [
    "target"
  ],
  "writes": [],
  "applicability": {
    "domains": [
      "generic"
    ],
    "requires": [
      "text_content"
    ]
  },
  "path_arguments": {
    "path": "target"
  },
  "invocation": {
    "kind": "python",
    "entry": "tools/outline/tool.py"
  }
}
