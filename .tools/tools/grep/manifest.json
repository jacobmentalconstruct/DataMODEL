{
  "contract_version": 1,
  "id": "grep",
  "description": "Regex search (respects .gitignore); output path:line:text.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "pattern": {
        "type": "string",
        "minLength": 1,
        "description": "Python regex"
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "file/dir scope"
      },
      "glob": {
        "type": "string",
        "minLength": 1,
        "description": "e.g. *.py, **/*.{ts,tsx}"
      },
      "mode": {
        "type": "string",
        "enum": [
          "content",
          "files",
          "count"
        ]
      },
      "context": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50,
        "description": "lines around hits"
      },
      "ignore_case": {
        "type": "boolean"
      },
      "literal": {
        "type": "boolean",
        "description": "pattern is plain text"
      },
      "multiline": {
        "type": "boolean",
        "description": "match across lines"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "description": "max hits (200)"
      },
      "all": {
        "type": "boolean",
        "description": "include ignored/vendor"
      }
    },
    "required": [
      "pattern"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "matches": {
        "type": "integer"
      },
      "files_matched": {
        "type": "integer"
      },
      "files_searched": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "error": {
        "type": "string"
      },
      "error_kind": {
        "type": "string"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": false
  },
  "reads": [
    "target"
  ],
  "writes": [],
  "applicability": {
    "domains": [
      "generic"
    ],
    "requires": [
      "text_content"
    ]
  },
  "path_arguments": {
    "path": "target"
  },
  "invocation": {
    "kind": "python",
    "entry": "tools/grep/tool.py"
  }
}
