{
  "contract_version": 1,
  "id": "read",
  "description": "Read text files with line numbers; many files per call; symbol= extracts one definition/section.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "offset": {
        "type": "integer",
        "minimum": 1,
        "description": "first line, 1-based"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000,
        "description": "lines per file (2000)"
      },
      "numbers": {
        "type": "boolean",
        "description": "line numbers (true)"
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000000,
        "description": "total output cap (256000)"
      },
      "symbol": {
        "type": "string",
        "description": "function, Class.method, or heading"
      },
      "raw": {
        "type": "boolean",
        "description": "notebooks as raw JSON"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "files": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      },
      "error_kind": {
        "type": "string"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": false
  },
  "reads": [
    "target"
  ],
  "writes": [],
  "applicability": {
    "domains": [
      "generic"
    ],
    "requires": [
      "text_file"
    ]
  },
  "path_arguments": {
    "path": "target",
    "paths": "target"
  },
  "invocation": {
    "kind": "python",
    "entry": "tools/read/tool.py"
  }
}
