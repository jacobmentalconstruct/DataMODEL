{
  "contract_version": 1,
  "id": "schema",
  "description": "Structure of data files: SQLite tables/keys/rows, CSV column types, JSON/JSONL shape, GraphML/GEXF graphs, Parquet (pyarrow).",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1, "description": "data file or dir (default root)"},
      "sample": {"type": "integer", "minimum": 1, "maximum": 100000, "description": "rows/items sampled (1000)"},
      "all": {"type": "boolean", "description": "include ignored/vendor"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "text": {"type": "string"},
      "files": {"type": "integer"},
      "error": {"type": "string"},
      "error_kind": {"type": "string"}
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "reads": ["target"],
  "writes": [],
  "applicability": {"domains": ["generic"], "requires": ["data_file"]},
  "path_arguments": {"path": "target"},
  "invocation": {"kind": "python", "entry": "tools/schema/tool.py"}
}
