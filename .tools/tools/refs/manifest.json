{
  "contract_version": 1,
  "id": "refs",
  "description": "Where a name is defined, imported, called and used (exact for Python via ast; word match elsewhere).",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "name": {"type": "string", "minLength": 1, "description": "identifier or Class.method"},
      "path": {"type": "string", "minLength": 1, "description": "file/dir scope"},
      "glob": {"type": "string", "minLength": 1},
      "text": {"type": "boolean", "description": "include non-Python word matches (true)"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 5000, "description": "max lines (150)"},
      "all": {"type": "boolean", "description": "include ignored/vendor"}
    },
    "required": ["name"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "text": {"type": "string"},
      "counts": {"type": "object"},
      "truncated": {"type": "boolean"},
      "error": {"type": "string"},
      "error_kind": {"type": "string"}
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "reads": ["target"],
  "writes": [],
  "applicability": {"domains": ["generic"], "requires": ["text_content"]},
  "path_arguments": {"path": "target"},
  "invocation": {"kind": "python", "entry": "tools/refs/tool.py"}
}
