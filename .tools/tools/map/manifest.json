{
  "contract_version": 1,
  "id": "map",
  "description": "One-screen project card: languages, layout, entry points, tests, data/model/graph files, library stack, largest files.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1, "description": "dir scope"},
      "all": {"type": "boolean", "description": "include ignored/vendor"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "text": {"type": "string"},
      "files": {"type": "integer"},
      "error": {"type": "string"},
      "error_kind": {"type": "string"}
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "reads": ["target"],
  "writes": [],
  "applicability": {"domains": ["generic"], "empty_target": true},
  "path_arguments": {"path": "target"},
  "invocation": {"kind": "python", "entry": "tools/map/tool.py"}
}
