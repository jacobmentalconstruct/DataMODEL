{
  "contract_version": 1,
  "id": "deps",
  "description": "Dependency graph: internal Python imports (cycles, importers), external vs declared packages, local HTML/JS links.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1, "description": "dir scope"},
      "module": {"type": "string", "minLength": 1, "description": "focus one file: its imports and importers"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 10000, "description": "max edge lines (300)"},
      "all": {"type": "boolean", "description": "include ignored/vendor"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "text": {"type": "string"},
      "edges": {"type": "integer"},
      "cycles": {"type": "integer"},
      "truncated": {"type": "boolean"},
      "error": {"type": "string"},
      "error_kind": {"type": "string"}
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "reads": ["target"],
  "writes": [],
  "applicability": {"domains": ["generic"], "requires": ["text_content"]},
  "path_arguments": {"path": "target", "module": "target"},
  "invocation": {"kind": "python", "entry": "tools/deps/tool.py"}
}
